cabal-version:      3.4
name:               fadeno-lang
version:            0.1.0.0
homepage:           dentrado.art
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Gardanta Spirito
maintainer:         guardspirit@protonmail.com
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common shared-properties
    ghc-options: -Wall -fmax-pmcheck-models=300
    default-language: GHC2021
    default-extensions:
        LambdaCase, UnicodeSyntax, BlockArguments, TemplateHaskell,
        OverloadedStrings, NoImplicitPrelude, DataKinds, OverloadedLists,
        TypeFamilies, ViewPatterns, QuasiQuotes, MultiWayIf, UndecidableInstances,
        PatternSynonyms, OrPatterns
    build-depends:
        base ^>=4.20.0.0,
        rio >= 0.1,
        containers >= 0.7,
        flatparse >= 0.5,
        prettyprinter >= 1,
        prettyprinter-ansi-terminal >= 1,
        fused-effects >= 1,
        cereal >= 0.5,
        bytestring >= 0.12,
        template-haskell >= 2,
        hashable >= 1.5,
        rrb-vector >= 0.2,
        filepath >= 1.5,
        file-io >= 0.1.5,
        directory >= 1.3,
        time >= 1,
        base64-bytestring >= 1.2,
        text >= 2.0,
        aeson >= 2.2

library
    import:           shared-properties
    hs-source-dirs:   src
    exposed-modules:  Parser, Normalize, Compiler, Arithmetic, NameGen, Ser, Context, Driver

executable fadeno-lang
    import:           shared-properties
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    fadeno-lang

test-suite fadeno-tests
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          TestMain.hs
    build-depends:
        fadeno-lang,
        tasty >= 1.4,
        tasty-golden >= 2.3,
        tasty-hunit >= 0.10,
        process >= 1.6
